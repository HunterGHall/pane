<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Pane</RootNamespace>
    <AssemblyName>Pane</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- For PaneThemeMode.System: SystemEvents.UserPreferenceChanged, to notice a live
         Windows light/dark switch. UseWPF pulls this assembly in transitively via the
         WindowsDesktop shared framework, but it's referenced explicitly here so that
         isn't an assumption the build silently depends on. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>

</Project>
