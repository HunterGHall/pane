<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sidebar navigation list. Compose items as plain ListBoxItems whose Content is,
        e.g., a horizontal StackPanel with an icon Path + a TextBlock label - see
        Pane.Template's MainWindow.xaml for a full example.
    -->
    <Style x:Key="Pane.NavItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="8,1" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Pane.Brush.Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Overlay" Background="{DynamicResource Pane.Brush.State.Hover}" CornerRadius="{DynamicResource Pane.Radius.Medium}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="{DynamicResource Pane.Brush.Accent.Subtle}" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Pane.Brush.Text.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pane.NavigationList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Pane.NavItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Sidebar shell surface (place a Pane.NavigationList and other content inside).  -->
    <Style x:Key="Pane.Sidebar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pane.Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pane.Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

</ResourceDictionary>
