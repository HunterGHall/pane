<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Pane.Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pane.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Pane.Radius.Medium}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.28" ShadowDepth="4" Color="Black" />
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True" Margin="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Pane.Radius.Small}" />
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="24" Height="24">
                                <ContentPresenter x:Name="Icon"
                                                   Width="16"
                                                   Height="16"
                                                   ContentSource="Icon" />
                                <Path x:Name="CheckMark"
                                      Width="9"
                                      Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,3.5 L3.2,6.5 L9,0.5"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Pane.Brush.Accent.Default}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.8"
                                      Visibility="Collapsed" />
                            </Grid>

                            <ContentPresenter Grid.Column="1"
                                               Margin="4,6,10,6"
                                               VerticalAlignment="Center"
                                               ContentSource="Header"
                                               TextElement.Foreground="{DynamicResource Pane.Brush.Text.Primary}" />

                            <TextBlock Grid.Column="2"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Pane.Brush.Text.Secondary}"
                                       Text="{TemplateBinding InputGestureText}" />

                            <Path x:Name="SubmenuArrow"
                                  Grid.Column="3"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Data="M0,0 L4,4 L0,8"
                                  Stretch="None"
                                  Stroke="{DynamicResource Pane.Brush.Text.Secondary}"
                                  StrokeLineJoin="Round"
                                  StrokeThickness="1.6"
                                  Visibility="Collapsed" />
                        </Grid>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               Placement="Right"
                               PopupAnimation="Fade">
                            <Border Padding="4"
                                    Background="{DynamicResource Pane.Brush.Background.Elevated}"
                                    BorderBrush="{DynamicResource Pane.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Pane.Radius.Medium}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" Direction="270" Opacity="0.28" ShadowDepth="4" Color="Black" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Pane.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Bg" Property="Margin" Value="0" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
