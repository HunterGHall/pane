<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource Pane.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Grid.Row="0"
                                           Margin="2,0,0,8"
                                           ContentSource="Header"
                                           TextElement.FontWeight="SemiBold"
                                           TextElement.Foreground="{DynamicResource Pane.Brush.Text.Secondary}" />
                        <Border Grid.Row="1"
                                Background="{DynamicResource Pane.Brush.Background.Surface}"
                                BorderBrush="{DynamicResource Pane.Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Pane.Radius.Medium}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
