<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Expander">
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Pane.Brush.Background.Surface}"
                            BorderBrush="{DynamicResource Pane.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Pane.Radius.Medium}">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderToggle"
                                          Cursor="Hand"
                                          Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="14,11">
                                            <ContentPresenter Content="{TemplateBinding Content}" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       ContentSource="Header"
                                                       TextElement.FontWeight="SemiBold"
                                                       TextElement.Foreground="{DynamicResource Pane.Brush.Text.Primary}" />
                                    <Path x:Name="Chevron"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Data="M0,0 L4,4 L8,0"
                                          RenderTransformOrigin="0.5,0.5"
                                          Stretch="None"
                                          Stroke="{DynamicResource Pane.Brush.Text.Secondary}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.6">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </ToggleButton>
                            <Border x:Name="ContentBorder"
                                    BorderBrush="{DynamicResource Pane.Brush.Border.Subtle}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="Collapsed">
                                <ContentPresenter Margin="14,10" ContentSource="Content" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
