<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Generic elevated surface for grouping content - not tied to any one widget.  -->
    <Style x:Key="Pane.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Pane.Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Pane.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Pane.Radius.Large}" />
        <Setter Property="Padding" Value="20" />
    </Style>

</ResourceDictionary>
