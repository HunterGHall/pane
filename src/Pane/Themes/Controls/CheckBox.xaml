<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Pane.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Pane.Brush.Border.Strong}"
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource Pane.Radius.Small}">
                            <Grid>
                                <Path x:Name="CheckMark"
                                      Width="9"
                                      Height="7"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0,3.5 L3.2,6.5 L9,0.5"
                                      Opacity="0"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Pane.Brush.Text.OnAccent}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.8" />
                                <Rectangle x:Name="DashMark"
                                           Width="10"
                                           Height="1.8"
                                           Fill="{DynamicResource Pane.Brush.Text.OnAccent}"
                                           Opacity="0"
                                           RadiusX="1"
                                           RadiusY="1" />
                            </Grid>
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                           Margin="9,0,0,0"
                                           VerticalAlignment="Center"
                                           TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pane.Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pane.Brush.Accent.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pane.Brush.Accent.Default}" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Pane.Brush.Accent.Default}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Pane.Brush.Accent.Default}" />
                            <Setter TargetName="DashMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
