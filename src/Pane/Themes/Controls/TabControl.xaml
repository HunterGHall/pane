<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Pane.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Pane.Font.Size.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,4,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="2" />
                        </Grid.RowDefinitions>
                        <ContentPresenter x:Name="Header"
                                           Grid.Row="0"
                                           Margin="14,8,14,10"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           ContentSource="Header"
                                           TextElement.FontWeight="SemiBold"
                                           TextElement.Foreground="{DynamicResource Pane.Brush.Text.Secondary}" />
                        <Border x:Name="Indicator" Grid.Row="1" Background="{DynamicResource Pane.Brush.Accent.Default}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Pane.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource Pane.Brush.Text.Primary}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Pane.Brush.Border.Subtle}" BorderThickness="0,0,0,1">
                            <TabPanel x:Name="HeaderPanel" IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                           Grid.Row="1"
                                           Margin="0,16,0,0"
                                           ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
