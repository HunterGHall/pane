<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Typography  -->
    <FontFamily x:Key="Pane.Font.Family">Segoe UI Variable, Segoe UI</FontFamily>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Font.Size.Caption">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Font.Size.Body">13.5</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Font.Size.Subtitle">16</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Font.Size.Title">22</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Font.Size.TitleLarge">30</System:Double>

    <!--  Corner radius  -->
    <CornerRadius x:Key="Pane.Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Pane.Radius.Medium">7</CornerRadius>
    <CornerRadius x:Key="Pane.Radius.Large">12</CornerRadius>
    <!--  WPF doesn't clamp CornerRadius to half the element's size, so a radius this large
          only renders as a clean stadium/pill on elements taller than ~48px - anything
          smaller needs an explicit radius of height/2 instead, or it self-intersects.  -->
    <CornerRadius x:Key="Pane.Radius.Pill">999</CornerRadius>

    <!--  Spacing  -->
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Spacing.XSmall">4</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Spacing.Small">8</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Spacing.Medium">12</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Spacing.Large">20</System:Double>
    <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="Pane.Spacing.XLarge">32</System:Double>

    <!--  Durations (seconds, used by animation Storyboards)  -->
    <Duration x:Key="Pane.Duration.Fast">0:0:0.10</Duration>
    <Duration x:Key="Pane.Duration.Medium">0:0:0.18</Duration>

</ResourceDictionary>
